{
  "manifest_version": 3,
  "name": "Averill selected-field companion",
  "version": "0.7.1",
  "description": "Ask for source-backed guidance beside one explicitly shared draft field. Local connection; no sending or publication.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/plus-jakarta-sans.ttf",
        "assets/mark.svg",
        "assets/howto-text.svg",
        "assets/howto-size.svg",
        "assets/howto-align.svg",
        "assets/howto-margin.svg",
        "assets/howto-contrast.svg",
        "assets/howto-group.svg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
