{
  "name": "averill-ai-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Averill company agent assistant desktop demo with fictional Vamo campaign",
  "main": "main.js",
  "scripts": {
    "prestart": "npm run build:extension && npm run build:context",
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build:ocr": "sh scripts/build-ocr.sh",
    "build:context": "sh scripts/build-context.sh",
    "package:mac": "npm run build:extension && npm run build:ocr && npm run build:context && electron-packager . Averill --platform=darwin --arch=arm64 --out=dist --overwrite --prune --no-asar --ignore=^/dist$",
    "verify:intake": "electron scripts/verify-multisource.cjs",
    "verify:feedback": "electron scripts/verify-feedback.cjs",
    "verify:external": "electron scripts/verify-external.cjs",
    "verify:task-review": "electron scripts/verify-task-review.cjs",
    "verify:native-window": "electron scripts/verify-native-window.cjs",
    "package:release": "node scripts/release.cjs",
    "verify:release": "node scripts/release.cjs --verify",
    "verify:browser": "electron scripts/verify-browser.cjs",
    "verify:nebius": "node scripts/verify-nebius.cjs",
    "probe:nebius": "node scripts/nebius-capabilities.cjs",
    "verify:cloud-ui": "electron scripts/verify-cloud-ui.cjs",
    "verify:live-cloud": "node scripts/verify-live-cloud.cjs",
    "verify:live-ui": "electron scripts/verify-live-ui.cjs",
    "verify:ui-e2e": "electron scripts/verify-ui-e2e.cjs",
    "verify:rehearsal": "node scripts/verify-rehearsal.cjs",
    "verify:contextual": "electron scripts/verify-contextual.cjs",
    "verify:canva-adapter": "electron scripts/verify-canva-adapter.cjs",
    "verify:canva-design": "electron scripts/verify-canva-design.cjs",
    "verify:accessibility": "electron scripts/verify-accessibility.cjs",
    "verify:guide": "electron scripts/verify-guide.cjs",
    "verify:demo-ai": "electron scripts/verify-demo-ai.cjs",
    "verify:pro-ui": "electron scripts/verify-pro-ui.cjs",
    "verify:pro-live": "node scripts/verify-pro-live.cjs",
    "verify:pro-demo-live": "node scripts/verify-pro-demo-live.cjs",
    "verify:pro-sentence-live": "node scripts/verify-pro-sentence-live.cjs",
    "verify:auto-connect": "node scripts/verify-auto-connect.cjs",
    "build:extension": "node scripts/build-extension.cjs",
    "pretest": "npm run build:extension"
  },
  "dependencies": {
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/geologica": "^5.3.0",
    "@fontsource/spline-sans": "^5.3.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.4"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
