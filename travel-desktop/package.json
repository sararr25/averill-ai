{
  "name": "averill-ai-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Averill company agent assistant desktop demo with fictional Aurelia Travel campaign",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "build:ocr": "sh scripts/build-ocr.sh",
    "package:mac": "npm run build:ocr && electron-packager . Averill --platform=darwin --arch=arm64 --out=dist --overwrite --prune --no-asar --ignore=^/dist$"
  },
  "dependencies": {
    "@fontsource/fragment-mono": "^5.3.0",
    "@fontsource/geologica": "^5.3.0",
    "@fontsource/spline-sans": "^5.3.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.4"
  }
}
