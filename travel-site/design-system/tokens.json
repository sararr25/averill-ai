{
  "name": "Common Miles",
  "version": "2.0",
  "source": "tokens.css",
  "tokens": {
    "p-cloud": "#f5f8ff",
    "p-night": "#10213e",
    "p-electric": "#2458f5",
    "p-mist": "#e5ecff",
    "p-lime": "#d8fa63",
    "p-paper": "var(--p-cloud)",
    "p-white": "#ffffff",
    "p-forest": "var(--p-night)",
    "p-forest-dark": "#0a1730",
    "p-sage": "var(--p-mist)",
    "p-slate": "#50617f",
    "p-clay": "var(--p-electric)",
    "p-line": "#cbd7ec",
    "p-ochre": "var(--p-lime)",
    "p-error": "#9b302e",
    "p-transparent": "transparent",
    "p-overlay": "#0a173073",
    "p-overlay-soft": "#0a173030",
    "p-image-fade": "#0a1730b3",
    "font-editorial": "'DM Sans', sans-serif",
    "font-ui": "'DM Sans', sans-serif",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "20px",
    "space-6": "24px",
    "space-8": "32px",
    "space-10": "40px",
    "space-12": "48px",
    "space-16": "64px",
    "space-20": "80px",
    "space-24": "96px",
    "radius-sm": "8px",
    "radius-md": "16px",
    "radius-pill": "999px",
    "duration-fast": "160ms",
    "duration-base": "240ms",
    "color-background": "var(--p-paper)",
    "color-surface": "var(--p-white)",
    "color-text": "var(--p-forest)",
    "color-muted": "var(--p-slate)",
    "color-primary": "var(--p-forest)",
    "color-primary-hover": "var(--p-forest-dark)",
    "color-primary-fg": "var(--p-white)",
    "color-accent": "var(--p-clay)",
    "color-soft": "var(--p-sage)",
    "color-border": "var(--p-line)",
    "color-focus": "var(--p-clay)",
    "color-error": "var(--p-error)",
    "color-overlay": "var(--p-overlay)",
    "color-image-overlay": "var(--p-image-fade)",
    "page-width": "1320px",
    "page-gutter": "clamp(20px, 4.5vw, 72px)",
    "section-gap": "clamp(64px, 8vw, 112px)",
    "button-bg": "var(--color-accent)",
    "button-fg": "var(--color-primary-fg)",
    "button-hover-bg": "#1648df",
    "button-radius": "10px",
    "button-height": "48px",
    "input-bg": "var(--color-surface)",
    "input-border": "var(--color-border)",
    "card-bg": "var(--color-background)",
    "card-divider": "var(--color-border)"
  }
}
